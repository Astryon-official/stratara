<?xml version="1.0" encoding="UTF-8"?>
<svg width="400" height="16" viewBox="0 0 400 16" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="progressFg" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#00aaff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0066cc;stop-opacity:1" />
    </linearGradient>
    <filter id="fgGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="400" height="16" rx="8" fill="url(#progressFg)" filter="url(#fgGlow)"/>
</svg>